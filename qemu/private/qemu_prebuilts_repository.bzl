"""Repository exposing public labels for the QEMU prebuilt binaries."""

load("//qemu/private:qemu_prebuilts.bzl", "qemu_prebuilt_aliases", "qemu_prebuilt_exec_platforms")

_PREBUILTS_BUILD_HEADER = """\
# Generated by @rules_qemu//qemu/private:qemu_prebuilts_repository.bzl.

package(default_visibility = ["//visibility:public"])
"""

_PREBUILTS_BUILD_CONFIG_SETTING = """\
config_setting(
    name = "{name}",
    constraint_values = [
{constraint_values}
    ],
)
"""

_PREBUILTS_BUILD_ALIAS = """\
alias(
    name = "{name}",
    actual = select(
        {{
{branches}
        }},
        no_match_error = "{no_match_error}",
    ),
)
"""

_NO_MATCH_ERROR = (
    "@qemu_prebuilts//:{name} resolves the QEMU prebuilt for the current " +
    "target platform, which must be Linux x86_64 or Linux aarch64. " +
    "Cross-compiling consumers should use the rules_qemu toolchains instead."
)

def _prebuilts_build_file():
    exec_platforms = qemu_prebuilt_exec_platforms()
    chunks = [_PREBUILTS_BUILD_HEADER]

    for exec_platform in exec_platforms:
        chunks.append(_PREBUILTS_BUILD_CONFIG_SETTING.format(
            constraint_values = "\n".join([
                '        "{}",'.format(constraint_value)
                for constraint_value in exec_platform.constraint_values
            ]),
            name = exec_platform.config_setting,
        ))

    for alias in qemu_prebuilt_aliases():
        chunks.append(_PREBUILTS_BUILD_ALIAS.format(
            branches = "\n".join([
                '            ":{}": "@{}//:{}",'.format(
                    exec_platform.config_setting,
                    alias.repos[exec_platform.exec_arch],
                    alias.name,
                )
                for exec_platform in exec_platforms
            ]),
            name = alias.name,
            no_match_error = _NO_MATCH_ERROR.format(name = alias.name),
        ))

    return "\n".join(chunks)

def _qemu_prebuilts_repository_impl(rctx):
    rctx.file("BUILD.bazel", _prebuilts_build_file())
    return rctx.repo_metadata(reproducible = True)

qemu_prebuilts_repository = repository_rule(
    implementation = _qemu_prebuilts_repository_impl,
)
